build*/
bin
lib
x64
steradian
steradian.dir
*.a
*.o

# in-source cmake/make output (older builds put these in the tree)
CMakeCache.txt
CMakeFiles
cmake_install.cmake
CMakeDoxygenDefaults.cmake
CMakeDoxyfile.in
Makefile
compile_commands.json

# rendered output
*.png
!res/textures/*.png
!tests/golden/*.png

# visual studio
.vs
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.sln

# visual studio code
.vscode

# agent worktrees
.claude/

# NOTE: third_party/ is deliberately NOT ignored. Both dependencies are tracked git
# submodules, and ignoring a submodule path stops git from seeing the gitlink.
