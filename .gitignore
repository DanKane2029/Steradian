# build output (any build* directory: build/, build-viewer/, build-asan/, ...)
build*/
bin
lib
x64
steradian
steradian.dir
*.a
*.o

# in-source cmake/make output (older builds put these in the tree)
CMakeCache.txt
CMakeFiles
cmake_install.cmake
CMakeDoxygenDefaults.cmake
CMakeDoxyfile.in
Makefile
compile_commands.json

# rendered output
*.png
!res/textures/*.png
!tests/golden/*.png
!docs/*.png

# visual studio
.vs
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.sln

# visual studio code
.vscode

# agent worktrees
.claude/

# NOTE: third_party/ is deliberately NOT ignored. json and glfw are tracked git
# submodules, and ignoring a submodule path stops git from seeing the gitlink.
#
# The GPU SDK is the exception: it is fetched by scripts/setup-gpu-deps.sh rather than
# tracked, because it is 62 MB of NVIDIA headers and libraries under their own licences,
# and because only a build with -DPT_ENABLE_GPU=ON needs it at all.
third_party/gpu/
